{
  "name": "oracle",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace=@signal/dreamdex-integration --if-present",
    "dev": "npm run dev --workspace=@signal/oracle-backend",
    "dev:dreamdex": "npm run typecheck --workspace=@signal/dreamdex-integration",
    "build": "npm run build --workspace=@signal/dreamdex-integration && npm run build --workspace=@signal/oracle-backend && npm run build --workspace=@signal/frontend --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace=@signal/oracle-backend",
    "db:generate": "npm run db:generate --workspace=@signal/oracle-backend",
    "db:migrate": "npm run db:migrate --workspace=@signal/oracle-backend",
    "db:seed": "npm run db:seed --workspace=@signal/oracle-backend"
  }
}
