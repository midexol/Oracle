# Somnia Shannon testnet only for now — see src/config.ts
NETWORK=testnet

# Overrides for the baked-in testnet defaults (leave unset to use them)
# DREAMDEX_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
# DREAMDEX_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws

# Only needed for server-signed flows (scripts, tests, ops tooling).
# The end-user "Back This Prediction" flow should sign with the user's own
# connected wallet (a viem WalletClient) in the browser instead — never a
# backend private key. See src/client.ts.
# PRIVATE_KEY=0x...

# Defaults true: log the order instead of sending it. Flip to false only once
# you've watched the logs and are ready to send real testnet transactions.
DRY_RUN=true
