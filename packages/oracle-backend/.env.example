# ---- Server ----
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# ---- Database (Neon / Supabase / local) ----
DATABASE_URL=postgresql://user:password@host/oracle?sslmode=require

# ---- Auth ----
# Any long random string. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Domain shown in the wallet signature prompt
AUTH_DOMAIN=oracle.local

# ---- DreamDEX integration ----
# mock = in-process simulator: the full loop, no network, no testnet funds.
# live = the real exchange, via @signal/dreamdex-integration.
DREAMDEX_MODE=mock
# Simulator speed. 20 => a "15M" contract settles in ~45s so you can demo the
# full predict -> back -> settle -> reputation loop live. Set 1 for real time.
MOCK_TIME_SCALE=20

# ---- DREAMDEX_MODE=live only (Somnia Shannon testnet) ----
# These belong to @signal/dreamdex-integration, not this service. Set them in
# the environment; the backend does not read or validate them.
#
#   NETWORK=testnet
#   DREAMDEX_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
#   DREAMDEX_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
#   DRY_RUN=true      # false actually sends orders. Default is true.

# ---- Background jobs ----
# Master switch for background DATABASE WRITES: market sync, the DreamDEX
# event bridge, the settlement sweep and order reconciliation. Set false for a
# read-only API replica - exactly one instance should run with it true.
ENABLE_JOBS=true
MARKET_SYNC_INTERVAL_MS=5000
RESOLVER_INTERVAL_MS=10000
# Chases orders whose on-chain fill event never arrived (restart, dropped socket)
RECONCILER_INTERVAL_MS=20000
