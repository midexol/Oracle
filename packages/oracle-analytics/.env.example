# SQLite connection string for zero-config local development
DATABASE_URL="file:./dev.db"

# Server
PORT=4000

# DreamDEX read access for the settlement watcher goes through
# @signal/dreamdex-integration, which has its own testnet defaults baked in
# (see packages/dreamdex-integration/.env.example) — copy NETWORK,
# DREAMDEX_INDEXER_URL, DREAMDEX_WS_RPC_URL here only if overriding them.
