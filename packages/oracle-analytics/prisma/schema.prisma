// Oracle Analytics & Prediction Engine — Prisma schema
// SQLite (for zero-config local dev).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String   @id @default(cuid())
  walletAddress String   @unique @map("wallet_address")
  username      String?
  avatar        String?
  createdAt     DateTime @default(now()) @map("created_at")

  predictions   Prediction[]
  analytics     UserAnalytics?
  categoryStats UserCategoryStats[]

  @@map("users")
}

model Prediction {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  marketId   String    @map("market_id")
  asset      String // e.g. "BTC", "ETH"
  duration   String // e.g. "15M", "1H"
  prediction String // "UP" | "DOWN"
  entryPrice Float     @map("entry_price") // implied probability (0,1) of the chosen direction at entry
  status     String    @default("PENDING") // "PENDING" | "RESOLVED"
  result     String? // "WON" | "LOST" | "CANCELLED"
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([marketId])
  @@index([userId])
  @@index([status])
  @@index([asset, duration])
  @@map("predictions")
}

model UserAnalytics {
  userId           String   @id @map("user_id")
  totalPredictions Int      @default(0) @map("total_predictions")
  totalWins        Int      @default(0) @map("total_wins")
  totalLosses      Int      @default(0) @map("total_losses")
  accuracy         Float    @default(0)
  predictionScore  Float    @default(50) @map("prediction_score")
  // Internal bookkeeping so the Bayesian-dampened score can be updated
  // incrementally on every settlement instead of re-scanning full history.
  scoreSum         Float    @default(0) @map("score_sum")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_analytics")
}

model UserCategoryStats {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  asset            String
  duration         String
  totalPredictions Int      @default(0) @map("total_predictions")
  totalWins        Int      @default(0) @map("total_wins")
  accuracy         Float    @default(0)
  scoreSum         Float    @default(0) @map("score_sum")
  categoryScore    Float    @default(50) @map("category_score")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, asset, duration])
  @@map("user_category_stats")
}
