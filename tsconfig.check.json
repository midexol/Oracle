{
  // Typechecks everything, including files outside the build's rootDir
  // (scripts, configs). `npm run build` still compiles only src/.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "drizzle.config.ts", "vitest*.config.ts"]
}
