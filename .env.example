# ---- Server ----
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# ---- Database (Neon / Supabase / local) ----
DATABASE_URL=postgresql://user:password@host/oracle?sslmode=require

# ---- Auth ----
# Any long random string. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Domain shown in the wallet signature prompt
AUTH_DOMAIN=oracle.local

# ---- DreamDEX integration ----
# mock  -> in-process simulator (no network, deterministic, great for demos)
# live  -> real DreamDEX SDK/API (wired once we have the Bot Kit)
DREAMDEX_MODE=mock
DREAMDEX_REST_URL=
DREAMDEX_WS_URL=
DREAMDEX_API_KEY=
# Simulator speed. 20 => a "15M" contract settles in ~45s so you can demo the
# full predict -> back -> settle -> reputation loop live. Set 1 for real time.
MOCK_TIME_SCALE=20

# ---- Somnia chain (Shannon testnet) ----
SOMNIA_CHAIN_ID=50312
SOMNIA_RPC_URL=https://dream-rpc.somnia.network
SOMNIA_WS_RPC_URL=
DREAMDEX_EXCHANGE_ADDRESS=

# ---- Background jobs ----
ENABLE_JOBS=true
MARKET_SYNC_INTERVAL_MS=5000
RESOLVER_INTERVAL_MS=10000
# Chases orders whose on-chain fill event never arrived (restart, dropped socket)
RECONCILER_INTERVAL_MS=20000
